{
  "manifest_version": 2,
  "name": "Better Start",
  "version": "1.0",
  "description": "Better Start – A minimal, keyboard-focused new tab with command grid, smart search, clock, weather, and light customization.",
  "author": "Ömer Duran",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "better-startpage@omerduran.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    }
  },
  "content_security_policy": "script-src 'self'; object-src 'self'; img-src 'self' data:",
  "web_accessible_resources": [
    "icons/*"
  ]
}