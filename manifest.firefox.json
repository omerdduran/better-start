{
  "manifest_version": 2,
  "name": "Better Startpage",
  "version": "1.0",
  "description": "A customizable startpage for quick navigation and search",
  "author": "Ömer Duran",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "better-startpage@omerduran.dev",
      "strict_min_version": "91.0"
    }
  },
  "content_security_policy": "script-src 'self'; object-src 'self'; img-src 'self' data: https://www.google.com;",
  "web_accessible_resources": [
    "icons/*"
  ]
}